/target
**/*.rs.bk
*.pdb

# Python mirror bytecode (mirror/ is the independent reference implementation).
__pycache__/

# fuzz artefacts (fuzz/ is outside the workspace and has its own target dir).
# seeds/ are curated regressions and MUST be committed; corpus/ is ephemeral.
/fuzz/target/
/fuzz/corpus/*/*
!/fuzz/corpus/
!/fuzz/corpus/*/
!/fuzz/corpus/*/.gitkeep
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/Cargo.lock

# The browser page is built, not written: `ui/template.html` and the wasm
# crate are the sources. Committing the 800 KiB result would let it drift
# behind the resolver it embeds, and a stat tool whose numbers are one commit
# stale is worse than one that has to be built.
/ui/assay.html
/ui/pkg/
